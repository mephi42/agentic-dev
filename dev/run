#!/usr/bin/env python3
"""Build and (re)start the dev containers in the background."""

import sys
from os import getgid, getuid
from os.path import exists
from pathlib import Path
from subprocess import check_call


def check_call_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    check_call(argv, **kwargs)


def main():
    dev_dir = Path(sys.argv[0]).parent
    # docker compose reads it, whoever runs it here.
    env = [f"UID={getuid()}", f"GID={getgid()}"]
    if exists("/dev/kvm"):
        env.append(f"KVM_GID={Path('/dev/kvm').stat().st_gid}")
    (dev_dir / ".env").write_text("".join(line + "\n" for line in env))
    check_call_verbose(
        [
            "docker",
            "compose",
            "up",
            "--build",
            "--force-recreate",
            "--remove-orphans",
            "--wait",
        ],
        cwd=dev_dir,
    )


if __name__ == "__main__":
    main()
