#!/usr/bin/env python3
import sys
from os import environ, getgid, getuid
from pathlib import Path
from subprocess import DEVNULL, Popen, call, check_call, check_output

import yaml


def call_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    return call(argv, **kwargs)


def check_call_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    check_call(argv, **kwargs)


def popen_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    return Popen(argv, **kwargs)


def main():
    agent_dir = Path(sys.argv[0]).parent
    project_dir = agent_dir.parent
    cfg = yaml.safe_load((project_dir / "agentic-dev.yml").read_text())

    agent = cfg["project"].get("agent", "claude")
    override = agent_dir / "docker-compose.override.yml"
    override.unlink(missing_ok=True)
    override.symlink_to(Path(agent) / "agent.yml")

    env = {
        **environ,
        "COMPOSE_PROJECT_NAME": f"{cfg['project']['name']}-agent",
        "UID": str(getuid()),
        "GID": str(getgid()),
        "PROJECT_DIR": str(project_dir.resolve()),
        "WORKING_DIR": cfg["project"]["working_dir"],
    }
    tunnels = []
    try:
        for host, host_cfg in cfg["hosts"].items():
            remote_home = check_output(["ssh", host, "pwd"], text=True).strip()
            tunnel_args = [
                "autossh",
                "-M",
                "0",
                "-o",
                "ServerAliveInterval=30",
                "-o",
                "ServerAliveCountMax=3",
                "-o",
                "StreamLocalBindUnlink=yes",
            ]
            for name, container_cfg in host_cfg["containers"].items():
                path = container_cfg["path"]
                local_sock = agent_dir / "home" / ".ssh" / f"sshd-{name}.sock"
                remote_sock = f"{remote_home}/{path}/dev/home/.ssh/sshd.sock"
                tunnel_args.extend(["-L", f"{local_sock}:{remote_sock}"])
            tunnel_args.extend(["-N", host])
            tunnels.append(popen_verbose(tunnel_args, stdin=DEVNULL))
        status = call_verbose(
            ["docker", "compose", "run", "--build", "--remove-orphans", "agent"],
            cwd=agent_dir,
            env=env,
        )
    finally:
        for tunnel in tunnels:
            tunnel.terminate()
        check_call_verbose(
            ["docker", "compose", "down"],
            cwd=agent_dir,
            env=env,
        )
    sys.exit(status)


if __name__ == "__main__":
    main()
