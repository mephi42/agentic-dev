#!/usr/bin/env python3
import sys
from os import environ, getgid, getuid
from os.path import normpath
from pathlib import Path
from subprocess import DEVNULL, Popen, call, check_call, check_output

import yaml


def call_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    return call(argv, **kwargs)


def check_call_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    check_call(argv, **kwargs)


def popen_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    return Popen(argv, **kwargs)


def main():
    agent_dir = Path(sys.argv[0]).parent
    project_dir = agent_dir.parent
    cfg = yaml.safe_load((project_dir / "agentic-dev.yml").read_text())

    agent = cfg["project"].get("agent", "claude")
    packages = list(cfg.get("localhost", {}).get("packages", []))

    rp_project = cfg["project"].get("review-prompts", "")
    if rp_project == "kernel":
        packages.append("coccinelle")

    (agent_dir / "common" / "packages-localhost.txt").write_text(
        "".join(pkg + "\n" for pkg in packages)
    )

    allow = "".join(e + "\n" for e in cfg.get("localhost", {}).get("allow", []))

    volumes = []
    for entry in cfg.get("localhost", {}).get("mounts", []):
        source, _, rest = entry.partition(":")
        target, _, mode = rest.partition(":")
        # Handle targets like "/home/user/../etc" gracefully.
        target = normpath(target)
        if not target.startswith("/") or mode not in ("", "ro", "rw"):
            sys.exit(
                f"{entry}: expected <host path>:<agent path> and maybe :ro or :rw"
            )
        source = (project_dir / Path(source).expanduser()).resolve()
        if not source.exists():
            # Prevent docker from creating missing sources as root.
            sys.exit(f"{entry}: {source} does not exist")
        if Path(target).is_relative_to("/home/user"):
            # Prevent docker from creating missing mount points as root.
            point = agent_dir / "home" / Path(target).relative_to("/home/user")
            point.parent.mkdir(parents=True, exist_ok=True)
            if source.is_dir():
                point.mkdir(exist_ok=True)
            else:
                point.touch()
        volumes.append(f"{source}:{target}:{mode or 'ro'}")
    run_yml = agent_dir / f"run-{cfg['project']['name']}.yml"
    run_yml.write_text(
        yaml.safe_dump(
            {
                "services": {
                    "agent": {"volumes": volumes},
                    "egress": {"build": {"args": {"ALLOW_LOCALHOST": allow}}},
                }
            },
            sort_keys=False,
        )
    )

    env = {
        **environ,
        "COMPOSE_FILE": ":".join(
            ["docker-compose.yml", f"{agent}/agent.yml", "init.yml", run_yml.name]
        ),
        "COMPOSE_PROJECT_NAME": f"{cfg['project']['name']}-agent",
        "UID": str(getuid()),
        "GID": str(getgid()),
        "PROJECT_DIR": str(project_dir.resolve()),
        "WORKING_DIR": cfg["project"]["working-dir"],
        "REVIEW_PROMPTS_PROJECT": rp_project,
    }
    tunnels = []
    try:
        for host, host_cfg in cfg.get("hosts", {}).items():
            remote_home = check_output(["ssh", host, "pwd"], text=True).strip()
            tunnel_args = [
                "autossh",
                "-M",
                "0",
                "-o",
                "ServerAliveInterval=30",
                "-o",
                "ServerAliveCountMax=3",
                "-o",
                "StreamLocalBindUnlink=yes",
            ]
            for name, container_cfg in host_cfg["containers"].items():
                path = container_cfg["path"]
                local_sock = agent_dir / "home" / ".ssh" / f"sshd-{name}.sock"
                remote_sock = f"{remote_home}/{path}/dev/home/.ssh/sshd.sock"
                tunnel_args.extend(["-L", f"{local_sock}:{remote_sock}"])
            tunnel_args.extend(["-N", host])
            tunnels.append(popen_verbose(tunnel_args, stdin=DEVNULL))
        status = call_verbose(
            ["docker", "compose", "run", "--build", "--remove-orphans", "agent"],
            cwd=agent_dir,
            env=env,
        )
    finally:
        for tunnel in tunnels:
            tunnel.terminate()
        check_call_verbose(
            ["docker", "compose", "down"],
            cwd=agent_dir,
            env=env,
        )
    sys.exit(status)


if __name__ == "__main__":
    main()
