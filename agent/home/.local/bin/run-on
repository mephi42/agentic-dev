#!/usr/bin/env python3
import sys
from os.path import expanduser, join
from subprocess import check_call, check_output


def check_call_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    check_call(argv, **kwargs)


def check_output_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    return check_output(argv, **kwargs)


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: run-on <container> [command...]")
    container, *command = sys.argv[1:]
    if len(command) == 0:
        command = ["bash", "-l"]
    super_root = expanduser("~")

    submodules = [
        sm
        for sm in check_output_verbose(
            ["git", "submodule", "foreach", "--quiet", "echo $sm_path"],
            cwd=super_root,
            text=True,
        ).split()
        if sm.startswith("src/")
    ]
    files = sorted(
        file
        for file in check_output_verbose(
            ["git", "ls-files", "src/"], cwd=super_root, text=True
        ).split()
        if file not in submodules
    )

    check_call_verbose(
        [
            "sync-git",
            f"--root={super_root}",
            *[f"--extra-repo={join(super_root, sm)}" for sm in submodules],
            *[f"--rsync={file}" for file in files],
            f"{container}:.",
            *command,
        ]
    )


if __name__ == "__main__":
    main()
