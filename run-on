#!/usr/bin/env python3
"""Run a command on a dev container, from the workstation shell.

usage: run-on <container> [command...]

Runs the agent's own `run-on` in the agent container, the only place that can
reach the dev containers, so `agent/run` has to be running.
"""

import sys
from os import execvp
from os.path import dirname
from pathlib import Path
from subprocess import check_output

import yaml


def main():
    args = sys.argv[1:]
    if len(args) == 0 or args[0] in ("-h", "--help"):
        sys.exit(__doc__.strip())
    project_dir = Path(dirname(sys.argv[0]) or ".")
    cfg = yaml.safe_load((project_dir / "agentic-dev.yml").read_text())
    containers = check_output(
        [
            "docker",
            "ps",
            "--quiet",
            "--filter",
            f"label=com.docker.compose.project={cfg['project']['name']}-agent",
            "--filter",
            "label=com.docker.compose.service=agent",
        ],
        text=True,
    ).split()
    if len(containers) == 0:
        sys.exit("no agent container: is ./agent/run running?")
    execvp(
        "docker",
        [
            "docker",
            "exec",
            "-it" if sys.stdin.isatty() else "-i",
            "--user",
            "user",
            "--env",
            "HOME=/home/user",
            containers[0],
            "run-on",
            *args,
        ],
    )


if __name__ == "__main__":
    main()
