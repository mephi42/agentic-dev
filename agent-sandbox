#!/usr/bin/env python3
"""Run an agent on the current directory, without scaffolding a project.

Creates a throwaway project in a temporary directory: no remote hosts, no
src/ submodules, just $PWD itself mounted as ~/src in the agent container.
Nothing in the project is worth keeping -- the images, the egress proxy, the
agent home and its credentials all live in agentic-dev itself -- so it is
generated from scratch each time and driven by the usual `init` and
`agent/run`.
"""

import argparse
import re
import shutil
import sys
from pathlib import Path
from subprocess import check_call
from tempfile import TemporaryDirectory

import yaml

AGENTIC_DEV = Path(__file__).resolve().parent
TEMPLATE = AGENTIC_DEV / "template"


def check_call_verbose(argv, **kwargs):
    print("+", " ".join(map(str, argv)), file=sys.stderr)
    check_call(argv, **kwargs)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-a",
        "--agent",
        default="claude",
        help="agent to run: a directory under ~/.local/share/agentic-dev/agent "
        "or a built-in one (default: claude)",
    )
    parser.add_argument(
        "-b",
        "--base-image",
        metavar="IMAGE",
        help="build the agent image on top of IMAGE, e.g. -b ubuntu:22.04 "
        "(default: ubuntu:24.04)",
    )
    parser.add_argument(
        "-p",
        "--package",
        action="append",
        default=[],
        metavar="PACKAGE",
        help="install an extra apt package into the agent container, e.g. "
        "-p gdb. Repeatable.",
    )
    parser.add_argument(
        "-A",
        "--allow",
        action="append",
        default=[],
        metavar="REGEX",
        help="let the agent reach the hosts matching REGEX through the egress "
        r"proxy, a tinyproxy filter line: -A '^pkg\.go\.dev$'. Repeatable.",
    )
    parser.add_argument(
        "-m",
        "--mount",
        action="append",
        default=[],
        metavar="PATH:AGENT_PATH[:rw]",
        help="share a host path with the agent at AGENT_PATH, typically "
        "credentials: -m ~/.aws:/home/user/.aws. Read-only unless :rw. "
        "Repeatable.",
    )
    parser.add_argument(
        "-t",
        "--tmp",
        metavar="SIZE",
        help="give the agent container a tmpfs /tmp of SIZE, exec allowed: "
        "-t 4g (default: /tmp on the image's writable layer, on disk)",
    )
    args = parser.parse_args()
    source = Path.cwd()

    with TemporaryDirectory(prefix="agentic-dev-sandbox-") as tmp:
        project = Path(tmp) / "project"
        shutil.copytree(TEMPLATE, project, symlinks=True)
        # The template's agent/dev/init/run-on symlinks are relative to this one.
        (project / "agentic-dev").symlink_to(AGENTIC_DEV)
        # agent/docker-compose.yml mounts all three.
        (project / "src").symlink_to(source)
        (project / ".gitmodules").touch()
        check_call_verbose(["git", "init", "--quiet", project])
        (project / "AGENTS.md").write_text(
            "# Project notes\n"
            "\n"
            "`~/src` is the source directory, shared with the host. There are no\n"
            "dev containers and no remote hosts, so `run-on` cannot work here:\n"
            "build and test right where you are.\n"
        )
        # Stable across runs, unlike the directory: it becomes COMPOSE_PROJECT_NAME.
        name = re.sub(r"[^a-z0-9_]+", "-", str(source).lower()).strip("-")
        cfg = {
            "project": {
                "name": f"sandbox-{name}",
                "working-dir": "src",
                "agent": args.agent,
            }
        }
        if args.base_image:
            cfg["project"]["base-image"] = args.base_image
        if args.package:
            cfg.setdefault("localhost", {}).setdefault("packages", []).extend(
                args.package
            )
        if args.allow:
            cfg.setdefault("localhost", {}).setdefault("allow", []).extend(args.allow)
        if args.mount:
            mounts = cfg.setdefault("localhost", {}).setdefault("mounts", [])
            for mount in args.mount:
                path, sep, rest = mount.partition(":")
                # Resolve relative to cwd, agent/run would use project directory.
                mounts.append(f"{Path(path).expanduser().resolve()}{sep}{rest}")
        if args.tmp:
            cfg.setdefault("localhost", {})["tmp"] = args.tmp
        (project / "agentic-dev.yml").write_text(
            "# Generated by agent-sandbox; edit agentic-dev.yml in a real project.\n"
            + yaml.safe_dump(cfg, sort_keys=False)
        )

        check_call_verbose([project / "init"])
        check_call_verbose([project / "agent" / "run"])


if __name__ == "__main__":
    main()
