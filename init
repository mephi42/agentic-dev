#!/usr/bin/env python3
import json
import shlex
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass
from os.path import dirname
from pathlib import Path
from subprocess import DEVNULL, check_call, check_output
from typing import List

import yaml

BASEDIR = Path(dirname(sys.argv[0]))


def check_call_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    check_call(argv, **kwargs)


def check_output_verbose(argv, **kwargs):
    print("+", argv, file=sys.stderr)
    return check_output(argv, **kwargs)


def source_repos(super_root: Path):
    """(path, url) for every checked-out src/ submodule of the superproject.

    NUL-separated fields, so that whitespace in a path or a URL survives.
    """
    fields = check_output_verbose(
        [
            "git",
            "submodule",
            "foreach",
            "--quiet",
            'printf "%s\\0%s\\0" "$sm_path" "$(git config remote.origin.url)"',
        ],
        cwd=super_root,
        text=True,
    ).split("\0")[:-1]
    return [
        (path, url)
        for path, url in zip(fields[::2], fields[1::2])
        if path.startswith("src/")
    ]


def ensure_key(priv: Path, comment: str):
    if priv.exists():
        return
    priv.parent.mkdir(parents=True, exist_ok=True)
    check_call_verbose(
        ["ssh-keygen", "-t", "ed25519", "-f", str(priv), "-N", "", "-C", comment]
    )


def ssh_client_config(names):
    """An ssh client config reaching each named container over its socket."""
    return "\n".join(
        f"Host {name}\n"
        f"    ProxyCommand socat - UNIX-CONNECT:/home/user/.ssh/sshd-{name}.sock\n"
        f"    User user\n"
        for name in names
    )


@dataclass
class Container:
    host: str
    name: str
    path: str
    packages: List[str]
    post_install: List[str]

    @property
    def overlay(self):
        """A per-container overlay, rsynced on top of the shared dev tree"""
        return BASEDIR / "dev-overlay" / self.name

    @property
    def ssh(self):
        return self.overlay / "home" / ".ssh"

    @property
    def host_priv(self):
        return self.ssh / "ssh_host_ed25519_key"

    @property
    def host_pub(self):
        return self.host_priv.with_suffix(".pub")

    @property
    def client_priv(self):
        return self.ssh / "id_ed25519"

    @property
    def client_pub(self):
        return self.client_priv.with_suffix(".pub")

    @property
    def override(self):
        return self.overlay / "docker-compose.override.yml"

    @property
    def tunnels(self):
        return self.overlay / "tunnels.yml"


def rel_files(root: Path):
    """Every file (excluding directories) below root, relative to it."""
    return {path.relative_to(root) for path in root.rglob("*") if not path.is_dir()}


def init_container(container, repos):
    """Prepare one container's host directory and (re)start the container."""
    # Clone the source repos on the host, unless they are already there. A dev
    # container mounts <path>/src as ~/src, which is what sync-git pushes into;
    # cloning from upstream is far cheaper than letting sync-git create an
    # empty repo and push the whole history into it over the tunnel.
    clone = []
    for path, url in repos:
        # && and || have equal precedence, so each repo needs its own
        # subshell: otherwise a failed clone falls through to the next.
        dest = shlex.quote(f"{container.path}/{path}")
        clone.append(
            f"(git -C {dest} rev-parse --git-dir >/dev/null 2>&1 || "
            f"git clone {shlex.quote(url)} {dest})"
        )
    if len(clone) > 0:
        check_call_verbose(["ssh", container.host, " && ".join(clone)], stdin=DEVNULL)

    # Distribute the shared dev tree and the container's overlay. main() has
    # checked that the two are disjoint, so they can go in a single rsync.
    dev = f"{container.path}/dev"
    check_call_verbose(["ssh", container.host, "mkdir", "-p", f"{dev}/"], stdin=DEVNULL)
    check_call_verbose(
        [
            "rsync",
            "-avz",
            f"{BASEDIR / 'dev'}/",
            f"{container.overlay}/",
            f"{container.host}:{dev}/",
        ],
        stdin=DEVNULL,
    )
    check_call_verbose(
        ["ssh", container.host, f"cd {shlex.quote(dev)} && ./run"], stdin=DEVNULL
    )


def main():
    cfg = yaml.safe_load((BASEDIR / "agentic-dev.yml").read_text())
    project = cfg["project"]
    containers = [
        Container(
            host=host,
            name=container,
            path=container_cfg["path"],
            packages=container_cfg.get("packages", []),
            post_install=container_cfg.get("post-install", []),
        )
        for host, host_cfg in cfg["hosts"].items()
        for container, container_cfg in host_cfg["containers"].items()
    ]

    # Build the compose override for the dev service. The project name is added
    # per container below.
    dev_service = {"working_dir": f"/home/user/{project['working-dir']}"}
    if project.get("kvm"):
        dev_service.setdefault("devices", []).append("/dev/kvm")
        dev_service.setdefault("environment", {})["HOST_KVM_GID"] = "$KVM_GID"
    if project.get("tracing"):
        dev_service.setdefault("cap_add", []).extend(
            ["CAP_BPF", "CAP_PERFMON", "CAP_SYS_RESOURCE"]
        )
        dev_service.setdefault("volumes", []).append(
            "/sys/kernel/tracing:/sys/kernel/tracing"
        )
    dev_service.setdefault("build", {}).setdefault("args", {}).update(
        {
            "BASE_IMAGE": project.get("base-image", ""),
            "LLVM_VERSION": str(project.get("llvm", "")),
            "RUST_VERSION": str(project.get("rust", "")),
            "CCACHE_MAXSIZE": str(project.get("ccache", "")),
        }
    )

    project_packages = list(project.get("packages", []))
    if project.get("ccache"):
        project_packages.append("ccache")

    # Generate the egress allowlist.
    allow = [
        r"^archive\.ubuntu\.com$",
        r"^files\.pythonhosted\.org$",
        r"^pypi\.org$",
        r"^security\.ubuntu\.com$",
        r"^github\.com$",
        r"^ports\.ubuntu\.com$",
        r"^gitlab\.com$",
    ]
    if project.get("llvm"):
        allow.append(r"^apt\.llvm\.org$")
    if project.get("rust"):
        allow.extend(
            [
                r"^index\.crates\.io$",
                r"^static\.crates\.io$",
                r"^crates\.io$",
            ]
        )
    (BASEDIR / "dev" / "egress" / "allow.txt").write_text(
        "".join(line + "\n" for line in allow)
    )

    # Generate the seccomp profile.
    seccomp_syscalls_append = (
        project.get("seccomp", {}).get("syscalls", {}).get("append", [])
    )
    if len(seccomp_syscalls_append) > 0:
        with open(
            Path(__file__).resolve().parent / "seccomp" / "default.json",
            encoding="utf-8",
        ) as fp:
            seccomp = json.load(fp)
        seccomp["syscalls"].extend(seccomp_syscalls_append)
        seccomp_json = "seccomp.json"
        with open(BASEDIR / "dev" / seccomp_json, "w", encoding="utf-8") as fp:
            json.dump(seccomp, fp, indent=4)
        dev_service.setdefault("security_opt", []).append(f"seccomp={seccomp_json}")

    # Generate keys.
    agent_ssh = BASEDIR / "agent" / "home" / ".ssh"
    agent_priv = agent_ssh / "id_ed25519"
    agent_pub = agent_ssh / "id_ed25519.pub"
    agent_hosts = agent_ssh / "known_hosts"
    agent_config = agent_ssh / "config"
    ensure_key(agent_priv, comment="agent")
    for container in containers:
        ensure_key(container.host_priv, comment=f"{container.name}-host")
        ensure_key(container.client_priv, comment=f"{container.name}-client")

    # Generate the agent's ssh client config, reaching every container.
    agent_config.write_text(ssh_client_config(c.name for c in containers))

    # Populate each container's overlay: keys, sshd config, compose override.
    # Authorize the agent and all containers (self included, so dev/ssh can log
    # in locally); trust the local (dev) and every peer's host key.
    known_hosts = []
    for container in containers:
        peers = [c for c in containers if c is not container]
        (container.ssh / "authorized_keys").write_bytes(
            agent_pub.read_bytes()
            + b"".join(c.client_pub.read_bytes() for c in containers)
        )
        (container.ssh / "known_hosts").write_text(
            f"dev {container.host_pub.read_text().strip()}\n"
            + "".join(
                f"{peer.name} {peer.host_pub.read_text().strip()}\n" for peer in peers
            )
        )
        (container.ssh / "config").write_text(
            ssh_client_config(peer.name for peer in peers)
        )
        container.override.write_text(
            yaml.safe_dump(
                {
                    "name": f"{project['name']}-{container.name}",
                    "services": {"dev": dev_service},
                },
                sort_keys=False,
            )
        )
        tunnels_by_host = {}
        for peer in peers:
            tunnels_by_host.setdefault(peer.host, []).append(
                {"name": peer.name, "path": peer.path}
            )
        container.tunnels.write_text(yaml.safe_dump(tunnels_by_host, sort_keys=False))
        # The apt package list: project-wide packages plus this container's.
        (container.overlay / "packages.txt").write_text(
            "".join(pkg + "\n" for pkg in project_packages + container.packages)
        )
        # Shell commands run in the dev image once the packages are installed:
        # project-wide first, then this container's.
        (container.overlay / "post-install.sh").write_text(
            "".join(
                cmd + "\n"
                for cmd in project.get("post-install", []) + container.post_install
            )
        )
        known_hosts.append(
            f"{container.name} {container.host_pub.read_text().strip()}\n"
        )
    agent_hosts.write_text("".join(known_hosts))

    # Make sure the overlay does not override anything.
    dev_dir = BASEDIR / "dev"
    dev_files = rel_files(dev_dir)
    for container in containers:
        shadowed = dev_files & rel_files(container.overlay)
        if len(shadowed) > 0:
            sys.exit(
                f"{container.overlay} shadows {dev_dir}: "
                + ", ".join(sorted(str(path) for path in shadowed))
            )

    # Set every container up: containers are independent of each other, so do
    # them all at once instead of waiting for each one in turn.
    repos = source_repos(BASEDIR)
    with ThreadPoolExecutor(max_workers=len(containers)) as executor:
        for future in as_completed(
            executor.submit(init_container, container, repos)
            for container in containers
        ):
            future.result()

    for command in project.get("post-init", []):
        check_call_verbose(command, shell=True, cwd=BASEDIR)


if __name__ == "__main__":
    main()
